{
	"schemaVersion": 1,
	"id": "asphodel_api",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"cassiancc"
	],
	"contact": {
		"homepage": "https://github.com/cassiancc/Asphodel-API",
		"sources": "https://github.com/cassiancc/Asphodel-API",
		"issues": "https://github.com/cassiancc/Asphodel-API/issues"
	},
	"license": "MIT",
	"icon": "assets/asphodel_api/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"cc.cassian.asphodel.fabric.FabricEvents"
		],
		"client": [
			"cc.cassian.asphodel.client.fabric.FabricClientEvents"
		]
	},
	"mixins": [
		"asphodel_api.mixins.json"
	],
	"accessWidener": "asphodel_api.classtweaker",
	"depends": {
		"fabricloader": ">=0.19.5",
